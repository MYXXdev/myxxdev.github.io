	<string>MYbloXX® DNS - Cloudflare 1.1.1.1</string>
	<key>PayloadOrganization</key>
	<string>MYXXdev™</string>
	<key>PayloadDescription</key>
	<string>Encrypted DNS (DNS over HTTPS) using Cloudflare 1.1.1.1. This profile only sets which DNS resolver iOS uses; it does not change MYbloXX® blocking. Remove it in Settings &gt; General &gt; VPN &amp; Device Management.</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.dnsSettings.managed</string>
