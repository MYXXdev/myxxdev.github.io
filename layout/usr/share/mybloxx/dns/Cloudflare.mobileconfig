	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>net.myxxdev.mybloxx.dns.cloudflare</string>
	<key>PayloadUUID</key>
	<string>DE7C9F14-2DB5-554F-81FE-5FC3A2D962FE</string>
