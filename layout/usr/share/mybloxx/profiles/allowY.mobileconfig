<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>net.myxxdev.mybloxx</string>
	<key>PayloadUUID</key>
	<string>257827F1-D835-45BD-85E2-F25056B81C6A</string>
	<key>PayloadDisplayName</key>
	<string>MYbloXX® (allowY)</string>
	<key>PayloadOrganization</key>
	<string>MYXXdev™</string>
	<key>PayloadDescription</key>
	<string>Legacy Mode: points iOS at the published allowY PAC. It works without MYbloXX® running and is separate from native MYbloXX® protection. Remove it in Settings &gt; General &gt; VPN &amp; Device Management to return to native protection.</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.proxy.http.global</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.apple.proxy.http.global.5608408B-C7B0-481B-AC3D-5F53CA96909F</string>
			<key>PayloadUUID</key>
			<string>AA900903-FE1C-4D59-8F8F-DE047CC42373</string>
			<key>PayloadDisplayName</key>
			<string>Global HTTP Proxy</string>
			<key>ProxyType</key>
			<string>Auto</string>
			<key>ProxyPACURL</key>
			<string>https://cdn.jsdelivr.net/gh/MYXXdev/myxxdev.github.io@master/MYbloXX/allowY.pac</string>
			<key>ProxyCaptiveLoginAllowed</key>
			<true/>
			<key>ProxyPACFallbackAllowed</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
