<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>net.myxxdev.mybloxx</string>
	<key>PayloadUUID</key>
	<string>FFB0B45E-9845-4AC6-8965-04DD10FF4FC7</string>
	<key>PayloadDisplayName</key>
	<string>MYbloXX® (noSocials)</string>
	<key>PayloadOrganization</key>
	<string>MYXXdev™</string>
	<key>PayloadDescription</key>
	<string>Legacy Mode: points iOS at the published noSocials PAC. It works without MYbloXX® running and is separate from native MYbloXX® protection. Remove it in Settings &gt; General &gt; VPN &amp; Device Management to return to native protection.</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.proxy.http.global</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.apple.proxy.http.global.FDD30EB4-0D97-4301-824F-075331C66FEC</string>
			<key>PayloadUUID</key>
			<string>94C3BD08-3037-4F07-A6B4-4C042DE97FAD</string>
			<key>PayloadDisplayName</key>
			<string>Global HTTP Proxy</string>
			<key>ProxyType</key>
			<string>Auto</string>
			<key>ProxyPACURL</key>
			<string>https://cdn.jsdelivr.net/gh/MYXXdev/myxxdev.github.io@master/MYbloXX/blockSocials.pac</string>
			<key>ProxyCaptiveLoginAllowed</key>
			<true/>
			<key>ProxyPACFallbackAllowed</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
