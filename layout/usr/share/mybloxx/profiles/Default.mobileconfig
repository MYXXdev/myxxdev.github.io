<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadIdentifier</key>
	<string>net.myxxdev.mybloxx</string>
	<key>PayloadUUID</key>
	<string>FD9913A0-D24B-4C09-93B0-D3F4066D8E79</string>
	<key>PayloadDisplayName</key>
	<string>MYbloXX® (Default)</string>
	<key>PayloadOrganization</key>
	<string>MYXXdev™</string>
	<key>PayloadDescription</key>
	<string>Legacy Mode: points iOS at the published Default PAC. It works without MYbloXX® running and is separate from native MYbloXX® protection. Remove it in Settings &gt; General &gt; VPN &amp; Device Management to return to native protection.</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.proxy.http.global</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadIdentifier</key>
			<string>com.apple.proxy.http.global.F0A95878-A788-4CD4-AC31-42EDDB342D63</string>
			<key>PayloadUUID</key>
			<string>7050428D-BAFC-46BD-9762-8C63D8A6330C</string>
			<key>PayloadDisplayName</key>
			<string>Global HTTP Proxy</string>
			<key>ProxyType</key>
			<string>Auto</string>
			<key>ProxyPACURL</key>
			<string>https://cdn.jsdelivr.net/gh/MYXXdev/myxxdev.github.io@master/MYbloXX/Default.pac</string>
			<key>ProxyCaptiveLoginAllowed</key>
			<true/>
			<key>ProxyPACFallbackAllowed</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
